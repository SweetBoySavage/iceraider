# Copy this file to .env and fill in the values. The real .env is never committed.

# MongoDB connection string (database NasaData). Keep it secret.
MONGODB_URI=

# Safety margin around the coastline, in metres. Pixels closer to land than this are shown as land,
# so a route never runs right along the shore. Default 1000. Values below 400 give a warning.
LAND_MARGIN_M=1000
